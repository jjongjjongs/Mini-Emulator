index e1dbec3..9e95d1b 100644
--- a/src/citra_libretro/citra_libretro.cpp
+++ b/src/citra_libretro/citra_libretro.cpp
@@ -2,6 +2,7 @@
 // Licensed under GPLv2 or any later version
 // Refer to the license.txt file included.
 
+#include <algorithm>
 #include <list>
 #include <numeric>
 #include <vector>
@@ -347,6 +348,47 @@ void UpdateSettings() {
         Settings::values.layout_option = Settings::LayoutOption::Default;
     }
 
+    // Mini Emulator: "W,H,top l,t,r,b,bottom l,t,r,b" in pixels of a W x H frame; a screen of
+    // zero size is not shown.
+    {
+        auto mini = LibRetro::FetchVariable("citra_mini_layout", "");
+        unsigned v[10];
+        int n = 0;
+        size_t at = 0;
+        while (n < 10 && at <= mini.size() && !mini.empty()) {
+            size_t comma = mini.find(',', at);
+            std::string part = mini.substr(at, comma == std::string::npos ? std::string::npos : comma - at);
+            if (part.empty() || part.find_first_not_of("0123456789") != std::string::npos || part.size() > 5) {
+                break;
+            }
+            v[n++] = static_cast<unsigned>(std::stoul(part));
+            if (comma == std::string::npos) {
+                break;
+            }
+            at = comma + 1;
+        }
+        if (n == 10 && v[0] >= 16 && v[1] >= 16 && v[0] <= 8192 && v[1] <= 8192) {
+            for (int k = 2; k < 10; k++) {
+                v[k] = std::min(v[k], (k % 2 == 0) ? v[0] : v[1]);
+            }
+            Settings::values.custom_layout = true;
+            Settings::values.custom_top_left = static_cast<u16>(v[2]);
+            Settings::values.custom_top_top = static_cast<u16>(v[3]);
+            Settings::values.custom_top_right = static_cast<u16>(std::max(v[4], v[2]));
+            Settings::values.custom_top_bottom = static_cast<u16>(std::max(v[5], v[3]));
+            Settings::values.custom_bottom_left = static_cast<u16>(v[6]);
+            Settings::values.custom_bottom_top = static_cast<u16>(v[7]);
+            Settings::values.custom_bottom_right = static_cast<u16>(std::max(v[8], v[6]));
+            Settings::values.custom_bottom_bottom = static_cast<u16>(std::max(v[9], v[7]));
+            LibRetro::settings.mini_frame_width = v[0];
+            LibRetro::settings.mini_frame_height = v[1];
+        } else {
+            Settings::values.custom_layout = false;
+            LibRetro::settings.mini_frame_width = 0;
+            LibRetro::settings.mini_frame_height = 0;
+        }
+    }
+
     auto deadzone = LibRetro::FetchVariable("citra_deadzone", "15");
     LibRetro::settings.deadzone = (float)std::stoi(deadzone) / 100;
 
