+// Mini Emulator, Wii 친구끼리 (see Socket.h).
+static bool MiniWfcHost(in_addr* host, u16* http_port)
+{
+  const char* value = std::getenv("MINI_EMULATOR_WFC");
+  if (value == nullptr || *value == '\0')
+    return false;
+  const std::string text(value);
+  const size_t colon = text.rfind(':');
+  const std::string ip = colon == std::string::npos ? text : text.substr(0, colon);
+  if (inet_pton(AF_INET, ip.c_str(), host) != 1)
+    return false;
+  *http_port = colon == std::string::npos ? 80 : static_cast<u16>(std::atoi(text.c_str() + colon + 1));
+  return true;
+}
+
+static bool MiniWfcEndsWith(const std::string& name, const std::string& suffix)
+{
+  return name.size() >= suffix.size() &&
+         name.compare(name.size() - suffix.size(), suffix.size(), suffix) == 0;
+}
+
+std::string WiiSockMan::MiniWfcRewriteName(const std::string& name)
+{
+  in_addr host;
+  u16 http_port;
+  if (!MiniWfcHost(&host, &http_port))
+    return name;
+  std::string lower = name;
+  for (char& c : lower)
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  if (MiniWfcEndsWith(lower, "nintendowifi.net") || MiniWfcEndsWith(lower, "gamespy.com") ||
+      MiniWfcEndsWith(lower, "mini.wfc"))
+  {
+    char text[INET_ADDRSTRLEN] = {};
+    inet_ntop(AF_INET, &host, text, sizeof(text));
+    INFO_LOG_FMT(IOS_NET, "Mini WFC: {} -> {}", name, text);
+    return text;
+  }
+  return name;
+}
+
 sockaddr_in WiiSockMan::ToNativeAddrIn(WiiSockAddrIn from)
 {
   sockaddr_in result;
@@ -1130,6 +1174,14 @@ sockaddr_in WiiSockMan::ToNativeAddrIn(WiiSockAddrIn from)
   result.sin_family = from.family;
   result.sin_port = from.port;
 
+  in_addr host;
+  u16 http_port;
+  if (MiniWfcHost(&host, &http_port) && result.sin_addr.s_addr == host.s_addr &&
+      result.sin_port == htons(80))
+  {
+    result.sin_port = htons(http_port);
+  }
+
   return result;
 }
 
