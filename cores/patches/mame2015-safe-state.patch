+/* Whether a state taken or restored now is whole: MAME itself waits while temporary
+   (anonymous) timers are pending, since their callbacks are not part of the state */
+bool retro_state_safe()
+{
+	return retro_global_machine != NULL && retro_global_machine->scheduler().can_save();
+}
