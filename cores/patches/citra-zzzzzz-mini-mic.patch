@@ -0,0 +1,31 @@
+// Copyright 2026 Mini Emulator
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <memory>
+#include "audio_core/input.h"
+
+namespace AudioCore {
+
+/// The 3DS microphone from the frontend's libretro microphone interface: what the frontend
+/// hands over is resampled to the rate the game asked for, 15 samples per update as the
+/// hardware writes them; silence while the frontend has nothing (or no microphone).
+class LibRetroInput final : public Input {
+public:
+    LibRetroInput();
+    ~LibRetroInput() override;
+
+    void StartSampling(const InputParameters& params) override;
+    void StopSampling() override;
+    bool IsSampling() override;
+    void AdjustSampleRate(u32 sample_rate) override;
+    Samples Read() override;
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl;
+};
+
+} // namespace AudioCore
