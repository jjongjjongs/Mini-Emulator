 BEGIN_HOTKEY_LIST(g_host_hotkeys)
 END_HOTKEY_LIST()
+
+// Whether the GS has presented a game picture yet (Mini Emulator). A state restored
+// before that leaves the GS without a picture for the rest of the session, and on
+// Vulkan the frames handed over from the first vsync do not tell (they are the
+// backbuffer, picture or not), so the frontend asks here before restoring one.
+extern "C" RETRO_API bool retro_pcee2_has_picture(void)
+{
+	return GSLibretro::NativeSize.load(std::memory_order_acquire) != 0;
+}
