+// Mini Emulator: update / DLC .pkg files the app queued for this game in
+// <pref>/pkg_queue/<TITLE ID>/ (each with "<file>.zrif" or "<file>.work.bin" beside it),
+// installed with install_pkg() before the game starts (an update goes into ux0/app, as Vita3K
+// does). Each result is a line in <pref>/pkg_installed/addons/<TITLE ID>.txt:
+// "ok <category> <version> <file>" or "fail - - <file>". A .pkg without a license stays queued.
+static void install_queued_pkgs(const fs::path &pref_path, const std::string &title_id, int sys_lang) {
+    const fs::path queue = pref_path / "pkg_queue" / title_id;
+    if (title_id.empty() || !fs::is_directory(queue))
+        return;
+    std::vector<fs::path> pkgs;
+    for (const auto &entry : fs::directory_iterator(queue)) {
+        if (fs::is_regular_file(entry.path()) && string_utils::tolower(entry.path().extension().string()) == ".pkg")
+            pkgs.push_back(entry.path());
+    }
+    std::sort(pkgs.begin(), pkgs.end());
+    const fs::path log_path = pref_path / "pkg_installed" / "addons" / (title_id + ".txt");
+    fs::create_directories(log_path.parent_path());
+    for (const auto &pkg : pkgs) {
+        const std::string name = pkg.filename().string();
+        std::string zrif = read_pkg_license(pkg);
+        if (zrif.empty()) {
+            lr_log(RETRO_LOG_WARN, "Queued PKG %s has no license; left queued\n", name.c_str());
+            continue;
+        }
+        auto emuenv = std::make_unique<EmuEnvState>();
+        emuenv->pref_path = pref_path;
+        emuenv->cache_path = pref_path / "cache";
+        emuenv->cfg.sys_lang = sys_lang;
+        fs::create_directories(emuenv->cache_path);
+        lr_msg("Installing update / DLC PKG...", 600);
+        const bool ok = install_pkg(pkg, *emuenv, zrif, [](float) {});
+        {
+            std::ofstream log(log_path.native(), std::ios::app);
+            if (ok)
+                log << "ok " << (emuenv->app_info.app_category.empty() ? "-" : emuenv->app_info.app_category) << " "
+                    << (emuenv->app_info.app_version.empty() ? "-" : emuenv->app_info.app_version) << " " << name << "\n";
+            else
+                log << "fail - - " << name << "\n";
+        }
+        lr_log(ok ? RETRO_LOG_INFO : RETRO_LOG_ERROR, "Queued PKG %s: %s\n", name.c_str(), ok ? "installed" : "failed");
+        if (!ok)
+            lr_msg("Update / DLC PKG failed: wrong license or broken file", 600);
+        fs::remove(pkg);
+        fs::remove(fs::path(pkg.string() + ".zrif"));
+        fs::remove(fs::path(pkg.string() + ".work.bin"));
+    }
+}
+
+GameInstallResult ensure_game_installed(const fs::path &game_path, const fs::path &pref_path, int sys_lang) {
+    GameInstallResult result = ensure_game_installed_base(game_path, pref_path, sys_lang);
+    if (result.success)
+        install_queued_pkgs(pref_path, result.title_id, sys_lang);
+    return result;
+}
