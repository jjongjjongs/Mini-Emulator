+// Mini Emulator: this build has no on-screen layer for the system dialogs a game opens
+// (the desktop build draws them with its GUI and the player answers), so a game waiting on
+// one waited forever (e.g. the trophy setup dialog at boot). They are answered here, each
+// frame, as a player most likely would: trophy setup done, a message's first button
+// (OK / YES), save data YES / OK or the first slot, text input as the game filled it in.
+// Dialogs without buttons (progress, "saving...") are left for the game to close.
+static void answer_common_dialogs(EmuEnvState &emuenv) {
+    auto &d = emuenv.common_dialog;
+    switch (d.type) {
+    case TROPHY_SETUP_DIALOG:
+        if (d.status == SCE_COMMON_DIALOG_STATUS_RUNNING) {
+            d.status = SCE_COMMON_DIALOG_STATUS_FINISHED;
+            d.result = SCE_COMMON_DIALOG_RESULT_OK;
+            lr_log(RETRO_LOG_INFO, "Dialog: trophy setup finished\n");
+        }
+        break;
+    case MESSAGE_DIALOG:
+        if (d.status == SCE_COMMON_DIALOG_STATUS_RUNNING && d.msg.btn_num > 0) {
+            d.msg.status = d.msg.btn_val[0];
+            d.result = SCE_COMMON_DIALOG_RESULT_OK;
+            d.status = SCE_COMMON_DIALOG_STATUS_FINISHED;
+            lr_log(RETRO_LOG_INFO, "Dialog: message \"%s\" answered with button %u\n", d.msg.message.c_str(), d.msg.btn_val[0]);
+        }
+        break;
+    case IME_DIALOG:
+        if (d.status == SCE_COMMON_DIALOG_STATUS_RUNNING) {
+            d.ime.status = SCE_IME_DIALOG_BUTTON_ENTER;
+            d.result = SCE_COMMON_DIALOG_RESULT_OK;
+            d.status = SCE_COMMON_DIALOG_STATUS_FINISHED;
+            lr_log(RETRO_LOG_INFO, "Dialog: text input entered as given\n");
+        }
+        break;
+    case SAVEDATA_DIALOG:
+        if (d.substatus != SCE_COMMON_DIALOG_STATUS_RUNNING)
+            break;
+        if (d.savedata.mode_to_display == SCE_SAVEDATA_DIALOG_MODE_LIST) {
+            d.savedata.selected_save = 0;
+            d.result = SCE_COMMON_DIALOG_RESULT_OK;
+            d.substatus = SCE_COMMON_DIALOG_STATUS_FINISHED;
+            lr_log(RETRO_LOG_INFO, "Dialog: save data list, first slot chosen\n");
+        } else if (d.savedata.btn_num > 0) {
+            uint32_t chosen = d.savedata.btn_val[0];
+            for (int i = 0; i < d.savedata.btn_num && i < 2; i++) {
+                if (d.savedata.btn_val[i] == SCE_SAVEDATA_DIALOG_BUTTON_ID_YES || d.savedata.btn_val[i] == SCE_SAVEDATA_DIALOG_BUTTON_ID_OK)
+                    chosen = d.savedata.btn_val[i];
+            }
+            d.savedata.button_id = chosen;
+            d.result = SCE_COMMON_DIALOG_RESULT_OK;
+            d.substatus = SCE_COMMON_DIALOG_STATUS_FINISHED;
+            lr_log(RETRO_LOG_INFO, "Dialog: save data \"%s\" answered with button %u\n", d.savedata.msg.c_str(), chosen);
+        }
+        break;
+    default:
+        break;
+    }
+}
