+bool PGF::GetGlyphBitmap(int charCode, std::vector<u8> &pixels, int &w, int &h, int &left, int &top, int &advance64) const {
+	Glyph glyph;
+	if (!GetCharGlyph(charCode, FONT_PGF_CHARGLYPH, glyph) || glyph.w < 0 || glyph.h < 0)
+		return false;
+	int dir = glyph.flags & FONT_PGF_BMP_OVERLAY;
+	if (dir != FONT_PGF_BMP_H_ROWS && dir != FONT_PGF_BMP_V_ROWS)
+		return false;
+
+	w = glyph.w;
+	h = glyph.h;
+	left = glyph.left;
+	top = glyph.top;
+	advance64 = glyph.advanceH;
+	int numberPixels = w * h;
+	std::vector<u8> decoded(numberPixels);
+	size_t bitPtr = glyph.ptr * 8;
+	int pixelIndex = 0;
+	// Same nibble RLE as DrawCharacter.
+	while (pixelIndex < numberPixels && bitPtr + 8 < fontDataSize * 8) {
+		int nibble = consumeBits(4, fontData, bitPtr);
+		int count;
+		int value = 0;
+		if (nibble < 8) {
+			value = consumeBits(4, fontData, bitPtr);
+			count = nibble + 1;
+		} else {
+			count = 16 - nibble;
+		}
+		for (int i = 0; i < count && pixelIndex < numberPixels; i++) {
+			if (nibble >= 8) {
+				value = consumeBits(4, fontData, bitPtr);
+			}
+			decoded[pixelIndex++] = value | (value << 4);
+		}
+	}
+
+	pixels.assign(numberPixels, 0);
+	for (int yy = 0; yy < h; ++yy) {
+		for (int xx = 0; xx < w; ++xx) {
+			pixels[yy * w + xx] = dir == FONT_PGF_BMP_H_ROWS ? decoded[yy * w + xx] : decoded[xx * h + yy];
+		}
+	}
+	return true;
+}
