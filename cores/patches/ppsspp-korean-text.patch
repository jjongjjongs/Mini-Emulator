+static bool IsHangul(int charCode) {
+	return (charCode >= 0x1100 && charCode <= 0x11FF) || (charCode >= 0x3130 && charCode <= 0x318F) ||
+		(charCode >= 0xAC00 && charCode <= 0xD7A3);
+}
+
+// The font to take a character from: the opened one, or for Hangul it lacks, the PSP's Korean
+// font. Games with a Korean keyboard draw it with the Japanese or Latin font they opened, and
+// every key came out as the game's missing-character mark.
+static const PGF *PGFForChar(const PGF *opened, int charCode, int glyphType) {
+	if (!IsHangul(charCode) || opened->HasChar(charCode, glyphType))
+		return opened;
+	for (const Font *font : internalFonts) {
+		if (strcmp(font->GetFontStyle().fontFileName, "kr0.pgf") == 0 && font->GetPGF()->HasChar(charCode, glyphType))
+			return font->GetPGF();
+	}
+	return opened;
+}
