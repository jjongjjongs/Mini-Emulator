+// Draws text with the PSP's own fonts from flash0 (kr0, jpn0, ltn0), for platforms with no
+// system text drawer (libretro). The PPGe atlas only has the Hangul syllables PPSSPP's own UI
+// uses and no jamo, so without this the Korean OSK keys all showed as U+FFFD.
+class PGFTextDrawer : public TextDrawer {
+public:
+	PGFTextDrawer() : TextDrawer(nullptr) {
+		for (const char *name : { "kr0.pgf", "jpn0.pgf", "ltn0.pgf" }) {
+			std::vector<u8> data;
+			if (pspFileSystem.ReadEntireFile(std::string("flash0:/font/") + name, data) < 0)
+				continue;
+			PGF *font = new PGF();
+			if (font->ReadPtr(data.data(), data.size())) {
+				fonts_.push_back(font);
+			} else {
+				delete font;
+			}
+		}
+		if (!fonts_.empty()) {
+			const PGFHeader &h = fonts_[0]->header;
+			ascent_ = (int)ceilf(std::abs((int)h.maxAscender) / 64.0f * SCALE);
+			descent_ = (int)ceilf(std::abs((int)h.maxDescender) / 64.0f * SCALE);
+		}
+	}
+	~PGFTextDrawer() override {
+		for (PGF *font : fonts_)
+			delete font;
+	}
+
+	bool IsReady() const override { return !fonts_.empty(); }
+	void SetOrCreateFont(const FontStyle &style) override { fontStyle_ = style; }
+
+	bool DrawStringBitmap(std::vector<uint8_t> &bitmapData, TextStringEntry &entry, Draw::DataFormat texFormat, std::string_view str, int align, bool fullColor) override {
+		if (str.empty() || texFormat != Draw::DataFormat::R8_UNORM) {
+			bitmapData.clear();
+			return false;
+		}
+		float fw, fh;
+		MeasureStringInternal(str, &fw, &fh);
+		int width = std::max(1, (int)fw);
+		int height = std::max(1, (int)fh);
+		bitmapData.assign(width * height, 0);
+
+		int baseline = 1 + ascent_;
+		float penX = 1.0f;
+		UTF8 utf(str);
+		while (!utf.end()) {
+			uint32_t c = utf.next();
+			if (c == '\n') {
+				baseline += LineHeight();
+				penX = 1.0f;
+				continue;
+			}
+			const GlyphBitmap &g = GetGlyph(c);
+			if (g.w > 0 && g.h > 0)
+				Blit(bitmapData, width, height, g, penX + g.left * SCALE, baseline - g.top * SCALE);
+			penX += g.advance;
+		}
+
+		entry.texture = nullptr;
+		entry.bmWidth = entry.width = width;
+		entry.bmHeight = entry.height = height;
+		entry.lastUsedFrame = frameCount_;
+		return true;
+	}
+
+protected:
+	void MeasureStringInternal(std::string_view str, float *w, float *h) override {
+		float lineW = 0.0f, maxW = 0.0f;
+		int lines = 1;
+		UTF8 utf(str);
+		while (!utf.end()) {
+			uint32_t c = utf.next();
+			if (c == '\n') {
+				maxW = std::max(maxW, lineW);
+				lineW = 0.0f;
+				lines++;
+				continue;
+			}
+			lineW += GetGlyph(c).advance;
+		}
+		maxW = std::max(maxW, lineW);
+		// Even width and a pixel of room each side, like the Android drawer.
+		*w = (float)((((int)ceilf(maxW) + 1) & ~1) + 2);
+		*h = (float)(lines * LineHeight() + 2);
+	}
+
+	bool SupportsColorEmoji() const override { return false; }
+	void ClearFonts() override {}
+
+private:
+	// PSP fonts are 18px; the other drawers render PPGe text at 22.5px (1.25 * 18pt).
+	static constexpr float SCALE = 1.25f;
+
+	struct GlyphBitmap {
+		std::vector<u8> pixels;
+		int w = 0, h = 0, left = 0, top = 0;
+		float advance = 0.0f;
+	};
+
+	int LineHeight() const { return ascent_ + descent_; }
+
+	const GlyphBitmap &GetGlyph(uint32_t c) {
+		auto it = glyphs_.find(c);
+		if (it != glyphs_.end())
+			return it->second;
+		GlyphBitmap &g = glyphs_[c];
+		// Characters no font has fall back to '?'.
+		for (uint32_t code : { c, (uint32_t)'?' }) {
+			for (PGF *font : fonts_) {
+				int advance64 = 0;
+				if (code <= 0xFFFF && font->GetGlyphBitmap((int)code, g.pixels, g.w, g.h, g.left, g.top, advance64)) {
+					g.advance = advance64 / 64.0f * SCALE;
+					return g;
+				}
+			}
+		}
+		g.advance = 0.0f;
+		return g;
+	}
+
+	// Draws a glyph scaled by SCALE with its top left at (x, y), bilinear filtered.
+	static void Blit(std::vector<uint8_t> &dst, int dstW, int dstH, const GlyphBitmap &g, float x, float y) {
+		auto sample = [&](int sx, int sy) -> float {
+			if (sx < 0 || sy < 0 || sx >= g.w || sy >= g.h)
+				return 0.0f;
+			return g.pixels[sy * g.w + sx];
+		};
+		int x1 = std::max(0, (int)floorf(x));
+		int y1 = std::max(0, (int)floorf(y));
+		int x2 = std::min(dstW, (int)ceilf(x + g.w * SCALE) + 1);
+		int y2 = std::min(dstH, (int)ceilf(y + g.h * SCALE) + 1);
+		for (int dy = y1; dy < y2; ++dy) {
+			float fy = (dy + 0.5f - y) / SCALE - 0.5f;
+			int sy = (int)floorf(fy);
+			float ty = fy - sy;
+			for (int dx = x1; dx < x2; ++dx) {
+				float fx = (dx + 0.5f - x) / SCALE - 0.5f;
+				int sx = (int)floorf(fx);
+				float tx = fx - sx;
+				float top = sample(sx, sy) * (1.0f - tx) + sample(sx + 1, sy) * tx;
+				float bottom = sample(sx, sy + 1) * (1.0f - tx) + sample(sx + 1, sy + 1) * tx;
+				int v = (int)(top * (1.0f - ty) + bottom * ty + 0.5f);
+				uint8_t &d = dst[dy * dstW + dx];
+				d = (uint8_t)std::max((int)d, std::min(v, 255));
+			}
+		}
+	}
+
+	std::vector<PGF *> fonts_;
+	std::map<uint32_t, GlyphBitmap> glyphs_;
+	int ascent_ = 18;
+	int descent_ = 5;
+};
