+// The frontend saves and restores states on its own thread while the VM's emulation thread
+// keeps running, so a state was read or written halfway through the VM's work and the game
+// crashed later (CIopBios::SleepThread, EE blocks jumping to 0). Hold the VM paused for the
+// duration, running the GS calls queued for this thread until the VM has stopped.
+class CStatePause
+{
+public:
+	CStatePause()
+	{
+		if(m_virtualMachine->GetStatus() == CVirtualMachine::PAUSED) return;
+		m_virtualMachine->PauseAsync();
+		auto gs = m_virtualMachine->GetGSHandler();
+		while(m_virtualMachine->GetStatus() != CVirtualMachine::PAUSED)
+		{
+			if(gs) gs->ProcessPendingCalls();
+			std::this_thread::yield();
+		}
+		if(gs) gs->ProcessPendingCalls();
+		m_paused = true;
+	}
+	~CStatePause()
+	{
+		if(m_paused) m_virtualMachine->Resume();
+	}
+
+private:
+	bool m_paused = false;
+};
