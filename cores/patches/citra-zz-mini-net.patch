+// ---- Mini Emulator: 3DS 통신 — local wireless between phones through a Citra room. ----
+// The host phone opens the room (and joins it); the others join it by address. Join blocks
+// for up to the connection timeout, so the app calls these off its main thread.
+namespace {
+std::atomic<int> mini_net_error{-1};
+Network::RoomMember::CallbackHandle<Network::RoomMember::Error> mini_net_error_handle;
+} // namespace
+
+extern "C" __attribute__((visibility("default"))) int citra_mini_net_start(int host, const char* address, int port,
+                                                                           const char* nickname, const char* console,
+                                                                           int max_members, const char* game) {
+    auto member = Network::GetRoomMember().lock();
+    auto room = Network::GetRoom().lock();
+    if (!member || !room || nickname == nullptr || console == nullptr) {
+        return 0;
+    }
+    if (!mini_net_error_handle) {
+        mini_net_error_handle = member->BindOnError(
+            [](const Network::RoomMember::Error& error) { mini_net_error = static_cast<int>(error); });
+    }
+    mini_net_error = -1;
+    const u16 room_port = port > 0 && port < 65536 ? static_cast<u16>(port) : Network::DefaultRoomPort;
+    if (member->IsConnected()) {
+        member->Leave();
+    }
+    if (host) {
+        if (room->GetState() != Network::Room::State::Open &&
+            !room->Create("Mini Emulator", "", "", room_port, "",
+                          static_cast<u32>(max_members > 1 ? max_members : 4), "", game ? game : "", 0,
+                          std::make_unique<Network::VerifyUser::NullBackend>(), {}, false)) {
+            LOG_ERROR(Network, "Mini Emulator: could not open the room on port {}", room_port);
+            return 0;
+        }
+    }
+    member->Join(nickname, console, host ? "127.0.0.1" : (address ? address : ""), room_port, 0,
+                 Network::NoPreferredMac, "");
+    return 1;
+}
+
+// State (0 none, 1 idle, 2 joining, 3 joined, 4 joined as host) | (last error + 1) << 8;
+// the members' names, one per line, into out.
+extern "C" __attribute__((visibility("default"))) int citra_mini_net_status(char* out, int size) {
+    auto member = Network::GetRoomMember().lock();
+    if (!member) {
+        return 0;
+    }
+    std::string names;
+    if (member->IsConnected()) {
+        for (const auto& info : member->GetMemberInformation()) {
+            names += info.nickname;
+            names += '\n';
+        }
+    }
+    if (out != nullptr && size > 0) {
+        snprintf(out, size, "%s", names.c_str());
+    }
+    return (static_cast<int>(member->GetState()) + 0) | ((mini_net_error.load() + 1) << 8);
+}
+
+extern "C" __attribute__((visibility("default"))) void citra_mini_net_stop() {
+    if (auto member = Network::GetRoomMember().lock()) {
+        if (member->IsConnected()) {
+            member->Leave();
+        }
+    }
+    if (auto room = Network::GetRoom().lock()) {
+        if (room->GetState() == Network::Room::State::Open) {
+            room->Destroy();
+        }
+    }
+}
