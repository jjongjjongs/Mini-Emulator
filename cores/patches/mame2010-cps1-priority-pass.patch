+/* NULL destination: only the priority bitmap is written, as tilemap_draw does
+   for a priority-only pass (CPS1's high layer). */
+static void cps_tm_pri_opaque(int count, uint8_t *pri, uint32_t pcode)
+{
+	int i;
+	if ((pcode & 0xffff) == 0xff00)
+		return;
+	for (i = 0; i < count; i++)
+		pri[i] = (pri[i] & (pcode >> 8)) | pcode;
+}
+
+static void cps_tm_pri_masked(const uint8_t *maskptr, int mask, int value, int count, uint8_t *pri, uint32_t pcode)
+{
+	int i;
+	if ((pcode & 0xffff) == 0xff00)
+		return;
+	for (i = 0; i < count; i++)
+		if ((maskptr[i] & mask) == value)
+			pri[i] = (pri[i] & (pcode >> 8)) | pcode;
+}
