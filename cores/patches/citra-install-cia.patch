+
+// Mini Emulator: install a CIA (game, update or DLC) into the user directory's virtual SD
+// or NAND without starting the emulator. user_dir is the Citra user directory (the one the
+// core uses when it runs, so the keys in sysdata/aes_keys.txt are found). Returns
+// Service::AM::InstallStatus (0 on success).
+extern "C" __attribute__((visibility("default"))) int citra_install_cia(
+        const char* user_dir, const char* path, void (*progress)(void*, uint64_t, uint64_t), void* user) {
+    if (user_dir == nullptr || path == nullptr) {
+        return static_cast<int>(Service::AM::InstallStatus::ErrorInvalid);
+    }
+    FileUtil::SetUserPath(std::string(user_dir));
+    auto status = Service::AM::InstallCIA(std::string(path), [=](std::size_t done, std::size_t total) {
+        if (progress != nullptr) {
+            progress(user, static_cast<uint64_t>(done), static_cast<uint64_t>(total));
+        }
+    });
+    return static_cast<int>(status);
+}
